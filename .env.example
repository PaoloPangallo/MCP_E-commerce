# ============================================================
# MCP E-Commerce — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit the real .env file to git.
# ============================================================

# --- App Environment ---
ENV=production

# --- JWT Authentication (REQUIRED in production) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=mcp-ecommerce
JWT_AUDIENCE=mcp-ecommerce-client

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=mcp_ecom
DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_db_password@localhost:5433/mcp_ecom

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@localhost:6379/0

# --- eBay API ---
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_IT

# --- LLM ---
GEMINI_API_KEY=your_gemini_api_key

# --- Frontend URLs (optional, for CORS whitelist) ---
FRONTEND_URLS=https://YOUR_FRONTEND.ngrok-free.app

# --- Server ---
MAX_CONCURRENT_STREAMS=10
